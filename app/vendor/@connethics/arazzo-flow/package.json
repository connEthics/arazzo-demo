{
  "name": "@connethics/arazzo-flow",
  "version": "0.1.0",
  "description": "Read-only React graph of an Arazzo 1.0.x / 1.1.x workflow: semantic nodes and edges, ELK layered layout in a CSP-friendly Web Worker, minimap, search, keyboard navigation, SVG/PNG/Mermaid export. Pure CSS (--af-* variables) themed by ConnEthics tokens or the user's VS Code theme.",
  "license": "MIT",
  "author": "ConnEthics",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./elk-worker.js": "./dist/elk-worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "arazzo",
    "openapi",
    "asyncapi",
    "workflow",
    "graph",
    "react",
    "xyflow",
    "elk"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.json && vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "shots": "node demo/screenshots.mjs"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@connethics/arazzo-core": "*",
    "elkjs": "^0.11.0",
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xyflow/react": "^12.12.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.7",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}
