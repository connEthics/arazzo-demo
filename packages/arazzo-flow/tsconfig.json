{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@connethics/arazzo-core": ["../arazzo-core/src/index.ts"],
      "@connethics/arazzo-flow": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "demo/src", "vitest.config.ts", "tsup.config.ts", "demo/vite.config.ts"]
}
